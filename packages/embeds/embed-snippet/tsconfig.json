{
  "extends": "@calcom/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react",
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "baseUrl": ".",
    "rootDir": "src",
    "module": "ESNext",
    "declaration": true,
    "outDir": "dist",
    "paths": {
      "@calcom/embed-core": ["../embed-core/src"],
      "@calcom/embed-react": ["../embed-react/src"]
    }
  },
  "include": ["src", "env.d.ts"],
  "exclude": ["dist", "build", "**/node_modules/**"]
}
